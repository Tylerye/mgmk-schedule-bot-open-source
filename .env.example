# Telegram secrets. Never commit real values.
BOT_TOKEN=
ADMIN_USER_ID=

# Public schedule source and target group.
DRIVE_FOLDER_ID=REPLACE_WITH_YOUR_PUBLIC_FOLDER_ID
GROUP_NAME=8Са
DISPLAY_GROUP_NAME=8-Сба
TIMEZONE=Europe/Minsk

# Runtime settings.
STATE_PATH=./data/state.json
SCHEDULE_POLL_SECONDS=60
PIN_SWITCH_TIME=16:00
HEALTH_PORT=8080
HEALTH_HOST=127.0.0.1
LOOKAHEAD_DAYS=5
HTTP_TIMEOUT_MS=30000
HTTP_RETRIES=3
LOG_LEVEL=info

# Cloudflare deployment helpers. Keep real values only in local .env,
# Cloudflare secrets, or GitHub Actions secrets as documented.
WORKER_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
PARSER_SHARED_SECRET=
GITHUB_ACTIONS_TOKEN=
