[Unit]
Description=MGMC 8-Сба Telegram schedule bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mgmk-schedule-bot
EnvironmentFile=/etc/mgmk-schedule-bot.env
Environment=NODE_ENV=production
Environment=STATE_PATH=/var/lib/mgmk-schedule-bot/state.json
ExecStart=/usr/bin/node /opt/mgmk-schedule-bot/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
User=mgmk-bot
Group=mgmk-bot
StateDirectory=mgmk-schedule-bot
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mgmk-schedule-bot
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mgmk-schedule-bot

[Install]
WantedBy=multi-user.target
